{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/logo/arch2.txt", // Path to your logo file
        "type": "auto",                    // 'auto' detects the best protocol for your terminal
        "width": 12,                       // Adjust width (in characters)
        "padding": {
            "top": 3,
            "right": 4,
            "left": 3
        },
        "color": {
            "1": "red"
        }                   // Color for the logo (using Fastfetch color codes)
    },
    "display": {
        "separator": "\t",              // Separator between modules
    },
    "modules": [
        {
            "key": "{#31}╭───────────╮{#31}",
            "type": "custom"
        },
        {
            "key": "{#31}│ {#31} user    {#keys}{#31}│",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "{#31}│ {#32}󰇅 hname   {#keys}{#31}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "type": "command",
            "key": "{#31}│ {#33}󱦟 os age  {#keys}{#31}│",
            "text": "printf \"\\e[0m%s days\\e[0m\" \"$(( ($(date +%s) - $(stat -c %W /)) / 86400 ))\""
        },
        {
            "key": "{#31}│ {#34}󰅐 uptime  {#keys}{#31}│",
            "type": "uptime"
        },
        {
            "key": "{#31}│ {#34}{icon} distro  {#keys}{#31}│",
            "type": "os"
        },
        {
            "key": "{#31}│ {#35} kernel  {#keys}{#31}│",
            "type": "kernel"
        },
        {
            "key": "{#31}│ {#36} wm      {#keys}{#31}│",
            "type": "wm"
        },
        {
            "key": "{#31}│ {#36}󰇄 desktop {#keys}{#31}│",
            "type": "de"
        },
        {
            "key": "{#31}│ {#31} term    {#keys}{#31}│",
            "type": "terminal"
        },
        {
            "key": "{#31}│ {#32} shell   {#keys}{#31}│",
            "type": "shell"
        },
        {
            "key": "{#31}│ {#33}󰍛 cpu     {#keys}{#31}│",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "{#31}│ {#34}󰉉 disk    {#keys}{#31}│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "{#31}│ {#36} memory  {#keys}{#31}│",
            "type": "memory"
        },
        {
            "key": "{#31}├───────────┤",
            "type": "custom"
        },
        {
            "key": "{#31}│ {#39} colors  {#keys}{#31}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "{#31}╰───────────╯",
            "type": "custom"
        }
    ]
}